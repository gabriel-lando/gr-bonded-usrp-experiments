+        // index, so advance a phasor instead of a sin/cos per subcarrier
+        {
+            const float a = 2 * M_PI * d_current_symbol * 80 * (d_epsilon0 + d_er) / 64;
+            const gr_complex step = exp(gr_complex(0, a));
