+#ifndef INCLUDED_IEEE802_11_SYNC_SHORT_FUSED_H
+#define INCLUDED_IEEE802_11_SYNC_SHORT_FUSED_H
+
+#include <gnuradio/block.h>
+#include <ieee802_11/api.h>
+
+namespace gr {
+namespace ieee802_11 {
+
+/*!
+ * \brief sync_short with the Schmidl-Cox front-end built in.
+ *
+ * Takes the raw baseband stream and computes the lag-16 autocorrelation,
+ * its 48-sample moving sum, the 64-sample power and their ratio internally,
+ * replacing the delay / conjugate / multiply / moving_average / complex_to_mag
+ * / complex_to_mag_squared / divide chain that feeds sync_short. Output and
+ * tags are the same as sync_short's.
+ */
+class IEEE802_11_API sync_short_fused : virtual public block
+{
+public:
+    typedef std::shared_ptr<sync_short_fused> sptr;
+    static sptr make(double threshold,
+                     unsigned int min_plateau,
+                     bool log = false,
+                     bool debug = false);
+};
+
+} // namespace ieee802_11
+} // namespace gr
+
+#endif /* INCLUDED_IEEE802_11_SYNC_SHORT_FUSED_H */
