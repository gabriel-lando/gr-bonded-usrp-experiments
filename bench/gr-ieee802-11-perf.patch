diff --git a/lib/sync_short_fused.cc b/lib/sync_short_fused.cc
new file mode 100644
index 0000000..9f15b54
--- /dev/null
+++ b/lib/sync_short_fused.cc
@@ -0,0 +1,268 @@
+/*
+ * Copyright (C) 2013, 2016 Bastian Bloessl <bloessl@ccs-labs.org>
+ *
+ * This program is free software: you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation, either version 3 of the License, or
+ * (at your option) any later version.
+ *
+ * This program is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ * GNU General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public License
+ * along with this program.  If not, see <http://www.gnu.org/licenses/>.
+ */
+#include "utils.h"
+#include <gnuradio/io_signature.h>
+#include <ieee802_11/sync_short_fused.h>
+#include <volk/volk.h>
+
+#include <algorithm>
+#include <iostream>
+#include <vector>
+
+using namespace gr::ieee802_11;
+
+static const int MIN_GAP = 480;
+static const int MAX_SAMPLES = 540 * 80;
+
+// Schmidl-Cox front-end geometry, as wired in front of sync_short in the
+// examples: short training symbol period, autocorrelation window and power
+// window (autocorrelation window + lag).
+static const int LAG = 16;
+static const int COR_WIN = 48;
+static const int PWR_WIN = COR_WIN + LAG;
+static const int HIST = PWR_WIN - 1; // past samples needed for sample n
+
+class sync_short_fused_impl : public sync_short_fused
+{
+
+public:
+    sync_short_fused_impl(double threshold,
+                          unsigned int min_plateau,
+                          bool log,
+                          bool debug)
+        : block("sync_short_fused",
+                gr::io_signature::make(1, 1, sizeof(gr_complex)),
+                gr::io_signature::make(1, 1, sizeof(gr_complex))),
+          d_log(log),
+          d_debug(debug),
+          d_state(SEARCH),
+          d_plateau(0),
+          d_freq_offset(0),
+          d_copied(0),
+          MIN_PLATEAU(min_plateau),
+          d_threshold(threshold),
+          d_threshold2(threshold * threshold),
+          d_buf(HIST, gr_complex(0, 0))
+    {
+
+        set_tag_propagation_policy(block::TPP_DONT);
+    }
+
+    int general_work(int noutput_items,
+                     gr_vector_int& ninput_items,
+                     gr_vector_const_void_star& input_items,
+                     gr_vector_void_star& output_items)
+    {
+
+        const gr_complex* in = (const gr_complex*)input_items[0];
+        gr_complex* out = (gr_complex*)output_items[0];
+
+        int noutput = noutput_items;
+        int ninput = ninput_items[0];
+        if (ninput <= 0) {
+            return 0;
+        }
+
+        // Contiguous view with the HIST samples preceding this call in front,
+        // so x[n - k] is valid for every k <= HIST. The stream starts from
+        // zeros, as the delay and moving-average blocks it replaces did.
+        d_buf.resize(HIST);
+        d_buf.insert(d_buf.end(), in, in + ninput);
+        x = d_buf.data() + HIST;
+
+        // Per-sample terms for the whole call in two SIMD passes, so the
+        // sliding windows below are just an add and a subtract per sample.
+        // P[m] = x[m] conj(x[m - LAG]) for m >= -(COR_WIN - 1);
+        // W[m] = |x[m]|^2 for m >= -HIST.
+        d_prod.resize(COR_WIN - 1 + ninput);
+        d_pow.resize(HIST + ninput);
+        volk_32fc_x2_multiply_conjugate_32fc(d_prod.data(),
+                                             x - (COR_WIN - 1),
+                                             x - (COR_WIN - 1) - LAG,
+                                             d_prod.size());
+        volk_32fc_magnitude_squared_32f(d_pow.data(), x - HIST, d_pow.size());
+        P = d_prod.data() + (COR_WIN - 1);
+        W = d_pow.data() + HIST;
+        init_sums();
+
+        int consumed = 0;
+        int produced = 0;
+
+        switch (d_state) {
+
+        case SEARCH: {
+            int i;
+
+            for (i = 0; i < ninput; i++) {
+                if (i) {
+                    advance(i);
+                }
+                if (above_threshold()) {
+                    if (d_plateau < MIN_PLATEAU) {
+                        d_plateau++;
+
+                    } else {
+                        d_state = COPY;
+                        d_copied = 0;
+                        d_freq_offset = arg(acc()) / 16;
+                        d_plateau = 0;
+                        insert_tag(nitems_written(0), d_freq_offset, nitems_read(0) + i);
+                        dout << "SHORT Frame!" << std::endl;
+                        break;
+                    }
+                } else {
+                    d_plateau = 0;
+                }
+            }
+
+            consumed = i;
+            break;
+        }
+
+        case COPY: {
+
+            // Frequency correction phasor, advanced by one multiply per sample
+            // instead of a sin/cos per sample; re-anchored to the exact value
+            // every 512 samples so float error cannot accumulate.
+            gr_complex rot = exp(gr_complex(0, -d_freq_offset * d_copied));
+            const gr_complex step = exp(gr_complex(0, -d_freq_offset));
+
+            int o = 0;
+            while (o < ninput && o < noutput && d_copied < MAX_SAMPLES) {
+                if (o) {
+                    advance(o);
+                }
+                if (above_threshold()) {
+                    if (d_plateau < MIN_PLATEAU) {
+                        d_plateau++;
+
+                        // there's another frame
+                    } else if (d_copied > MIN_GAP) {
+                        d_copied = 0;
+                        d_plateau = 0;
+                        d_freq_offset = arg(acc()) / 16;
+                        insert_tag(
+                            nitems_written(0) + o, d_freq_offset, nitems_read(0) + o);
+                        dout << "SHORT Frame!" << std::endl;
+                        break;
+                    }
+
+                } else {
+                    d_plateau = 0;
+                }
+
+                out[o] = x[o - LAG] * rot;
+                o++;
+                d_copied++;
+                if ((d_copied & 511) == 0) {
+                    rot = exp(gr_complex(0, -d_freq_offset * d_copied));
+                } else {
+                    rot *= step;
+                }
+            }
+
+            if (d_copied == MAX_SAMPLES) {
+                d_state = SEARCH;
+            }
+
+            dout << "SHORT copied " << o << std::endl;
+
+            consumed = o;
+            produced = o;
+            break;
+        }
+
+        default:
+            throw std::runtime_error("sync short fused: unknown state");
+        }
+
+        // Keep the HIST samples preceding the first unconsumed one.
+        std::copy(d_buf.begin() + consumed,
+                  d_buf.begin() + consumed + HIST,
+                  d_buf.begin());
+        d_buf.resize(HIST);
+
+        consume_each(consumed);
+        return produced;
+    }
+
+    void insert_tag(uint64_t item, double freq_offset, uint64_t input_item)
+    {
+        mylog("frame start at in: {} out: {}", item, input_item);
+
+        const pmt::pmt_t key = pmt::string_to_symbol("wifi_start");
+        const pmt::pmt_t value = pmt::from_double(freq_offset);
+        const pmt::pmt_t srcid = pmt::string_to_symbol(name());
+        add_item_tag(0, item, key, value, srcid);
+    }
+
+private:
+    // Running sums for sample 0 of this call, built from the history. They are
+    // rebuilt every call, so rounding cannot accumulate across calls.
+    void init_sums()
+    {
+        d_acc = 0;
+        d_pwr = 0;
+        for (int k = 0; k < COR_WIN; k++) {
+            d_acc += std::complex<double>(P[-k]);
+        }
+        for (int k = 0; k < PWR_WIN; k++) {
+            d_pwr += W[-k];
+        }
+    }
+
+    // Slide both windows from sample n - 1 to sample n.
+    void advance(int n)
+    {
+        d_acc += std::complex<double>(P[n] - P[n - COR_WIN]);
+        d_pwr += W[n] - W[n - PWR_WIN];
+    }
+
+    gr_complex acc() const { return gr_complex(d_acc.real(), d_acc.imag()); }
+    // |acc| / pwr > threshold, without the sqrt and divide. Same decision:
+    // when pwr is 0 the window is all zeros and both forms are false.
+    bool above_threshold() const
+    {
+        return std::norm(d_acc) > d_threshold2 * d_pwr * d_pwr;
+    }
+
+    enum { SEARCH, COPY } d_state;
+    int d_copied;
+    int d_plateau;
+    float d_freq_offset;
+    const double d_threshold;
+    const double d_threshold2;
+    const bool d_log;
+    const bool d_debug;
+    const unsigned int MIN_PLATEAU;
+
+    std::vector<gr_complex> d_buf;
+    std::vector<gr_complex> d_prod;
+    std::vector<float> d_pow;
+    const gr_complex* x = nullptr;
+    const gr_complex* P = nullptr;
+    const float* W = nullptr;
+    std::complex<double> d_acc;
+    double d_pwr = 0;
+};
+
+sync_short_fused::sptr
+sync_short_fused::make(double threshold, unsigned int min_plateau, bool log, bool debug)
+{
+    return gnuradio::get_initial_sptr(
+        new sync_short_fused_impl(threshold, min_plateau, log, debug));
+}
